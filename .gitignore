# Data: fetched at run time, governed by src/sources.yaml.
# data/curated/ is human-curated and stays tracked.
data/raw/*
data/processed/*
!data/raw/.gitkeep
!data/processed/.gitkeep

# Private notes, never committed.
local/

# Environment
.venv/
.env
.python-version.local

# Python
__pycache__/
*.py[cod]
.pytest_cache/
.ruff_cache/
*.egg-info/
build/
dist/
