# render.yaml.stub
#
# Documentation-only stub for the later one-step Render deployment.
# Nothing here is active. To activate, rename this file to render.yaml,
# review every line, and connect the repository in the Render dashboard.
#
# The app follows standard Dash + gunicorn mechanics: app.py builds the
# Dash app at import and exposes `server = app.server`, so the start
# command is simply `gunicorn app:server`.
#
# services:
#   - type: web
#     name: el-nino-atlas
#     runtime: python
#     plan: free                      # upgrade if the placeholder becomes a live tool
#     buildCommand: |
#       pip install uv
#       uv sync --locked --no-dev     # runtime deps only, from the committed lock
#     startCommand: uv run gunicorn app:server --bind 0.0.0.0:$PORT
#     envVars:
#       - key: PYTHON_VERSION
#         value: "3.11"
#       - key: ATLAS_DEBUG
#         value: "false"
#       # ATLAS_HOST/ATLAS_PORT are not needed: gunicorn binds to Render's $PORT.
#     healthCheckPath: /
#
# Notes
# - Data are fetched at run time (python run.py update) and are not
#   committed unless src/sources.yaml says redistribution: "yes"; a
#   scheduled job or cron service would be added here later for that.
# - Do not enable auto-deploy until the licence gate tests pass in CI.
